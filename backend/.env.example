# Server
PORT=4100
NODE_ENV=development

# Security
# Generate a strong random value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS — origin(s) allowed to call this API (comma-separated for multiple)
CORS_ORIGIN=http://localhost:5600,http://127.0.0.1:5600

# Database
DB_PATH=./data/medicore.db

# Rate limiting
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=300
